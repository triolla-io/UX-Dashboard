OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
PORT=3001

# Usage tracking (how many people ran an audit).
# Path to the SQLite file. Point this at a persistent volume in production
# so the data survives redeploys. Defaults to data/usage.db.
USAGE_DB_PATH=data/usage.db
# Optional: require this token to read GET /api/stats
# (via ?token=... or the x-stats-token header). Leave unset to make stats public.
STATS_TOKEN=

# Abuse protection
# Per-IP free audits per 24h (default 2)
MAX_FREE_USES=2
# Hard ceiling on audits per UTC day across everyone. Unset = no cap.
GLOBAL_DAILY_CAP=300
# Cloudflare Turnstile. Unset TURNSTILE_SECRET_KEY to disable bot verification.
TURNSTILE_SECRET_KEY=
# Usage log screenshots
# Directory for saved screenshots (mount a persistent volume here in prod).
IMAGE_UPLOAD_DIR=data/uploads
# Days to keep screenshots before the retention sweep deletes them (metadata is kept).
IMAGE_RETENTION_DAYS=30
